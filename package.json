{
  "name": "dilops-file-browser",
  "displayName": "File Browser",
  "description": "A native sidebar file browser for navigating arbitrary paths outside the workspace.",
  "version": "0.5.4",
  "publisher": "dilops",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:dilopsFileBrowser.tree"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dilopsFileBrowser",
          "title": "File Browser",
          "icon": "$(folder-library)"
        }
      ]
    },
    "views": {
      "dilopsFileBrowser": [
        {
          "id": "dilopsFileBrowser.tree",
          "name": "Bookmarks",
          "icon": "$(folder-library)",
          "contextualTitle": "File Browser"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dilopsFileBrowser.tree",
        "contents": "No bookmarks yet.\n[Add Bookmark](command:dilopsFileBrowser.addBookmark)\n[New Group](command:dilopsFileBrowser.newGroup)\nPin any directory on disk — your home, a shares path, anywhere. Contents load lazily and files open with a single click."
      }
    ],
    "commands": [
      { "command": "dilopsFileBrowser.addBookmark", "title": "Add Bookmark…", "category": "File Browser", "icon": "$(add)" },
      { "command": "dilopsFileBrowser.addBookmarkByPath", "title": "Add Bookmark by Path…", "category": "File Browser" },
      { "command": "dilopsFileBrowser.removeBookmark", "title": "Remove Bookmark", "category": "File Browser", "icon": "$(remove)" },
      { "command": "dilopsFileBrowser.renameBookmark", "title": "Rename Bookmark…", "category": "File Browser", "icon": "$(edit)" },
      { "command": "dilopsFileBrowser.moveBookmarkToGroup", "title": "Move to Group…", "category": "File Browser" },
      { "command": "dilopsFileBrowser.newGroup", "title": "New Group…", "category": "File Browser", "icon": "$(new-folder)" },
      { "command": "dilopsFileBrowser.renameGroup", "title": "Rename Group…", "category": "File Browser" },
      { "command": "dilopsFileBrowser.deleteGroup", "title": "Delete Group…", "category": "File Browser" },
      { "command": "dilopsFileBrowser.refresh", "title": "Refresh", "category": "File Browser", "icon": "$(refresh)" },
      { "command": "dilopsFileBrowser.enableShowHiddenFiles", "title": "Show Hidden Files", "category": "File Browser", "icon": "$(eye)" },
      { "command": "dilopsFileBrowser.disableShowHiddenFiles", "title": "Hide Hidden Files", "category": "File Browser", "icon": "$(eye-closed)" },
      { "command": "dilopsFileBrowser.revealInOS", "title": "Reveal in OS File Manager", "category": "File Browser" },
      { "command": "dilopsFileBrowser.copyPath", "title": "Copy Path", "category": "File Browser" },
      { "command": "dilopsFileBrowser.openInTerminal", "title": "Open in Integrated Terminal", "category": "File Browser" },
      { "command": "dilopsFileBrowser.addChildAsBookmark", "title": "Bookmark This Folder", "category": "File Browser" },
      { "command": "dilopsFileBrowser.openFile", "title": "Open File", "category": "File Browser" },
      { "command": "dilopsFileBrowser.clearRecent", "title": "Clear Recent Files", "category": "File Browser", "icon": "$(clear-all)" },
      { "command": "dilopsFileBrowser.newFile", "title": "New File…", "category": "File Browser", "icon": "$(new-file)" },
      { "command": "dilopsFileBrowser.newFolder", "title": "New Folder…", "category": "File Browser", "icon": "$(new-folder)" },
      { "command": "dilopsFileBrowser.rename", "title": "Rename…", "category": "File Browser" },
      { "command": "dilopsFileBrowser.delete", "title": "Delete (Move to Trash)", "category": "File Browser" },
      { "command": "dilopsFileBrowser.duplicate", "title": "Duplicate", "category": "File Browser" },
      { "command": "dilopsFileBrowser.searchInBookmark", "title": "Search Files…", "category": "File Browser", "icon": "$(search)" },
      { "command": "dilopsFileBrowser.goToPath", "title": "Go To Path…", "category": "File Browser", "icon": "$(go-to-file)" },
      { "command": "dilopsFileBrowser.sortBy", "title": "Sort By…", "category": "File Browser", "icon": "$(sort-precedence)" },
      { "command": "dilopsFileBrowser.enableShowModified", "title": "Show Modified Dates", "category": "File Browser", "icon": "$(calendar)" },
      { "command": "dilopsFileBrowser.disableShowModified", "title": "Hide Modified Dates", "category": "File Browser", "icon": "$(calendar)" },
      { "command": "dilopsFileBrowser.enableShowSize", "title": "Show File Sizes", "category": "File Browser", "icon": "$(symbol-numeric)" },
      { "command": "dilopsFileBrowser.disableShowSize", "title": "Hide File Sizes", "category": "File Browser", "icon": "$(symbol-numeric)" },
      { "command": "dilopsFileBrowser.copy", "title": "Copy", "category": "File Browser" },
      { "command": "dilopsFileBrowser.cut", "title": "Cut", "category": "File Browser" },
      { "command": "dilopsFileBrowser.paste", "title": "Paste", "category": "File Browser" },
      { "command": "dilopsFileBrowser.clearClipboard", "title": "Clear Clipboard", "category": "File Browser" },
      { "command": "dilopsFileBrowser.revealActiveEditor", "title": "Reveal Active Editor File", "category": "File Browser", "icon": "$(target)" },
      { "command": "dilopsFileBrowser.compare", "title": "Compare Files", "category": "File Browser" },
      { "command": "dilopsFileBrowser.setTypeFilter", "title": "Filter by File Type…", "category": "File Browser", "icon": "$(filter)" },
      { "command": "dilopsFileBrowser.runFile", "title": "Run File", "category": "File Browser", "icon": "$(play)" },
      { "command": "dilopsFileBrowser.refreshDiskUsage", "title": "Refresh Disk Usage (all bookmarks)", "category": "File Browser" },
      { "command": "dilopsFileBrowser.showBookmarkDiskUsage", "title": "Compute Disk Usage", "category": "File Browser" },
      { "command": "dilopsFileBrowser.showLog", "title": "Show Log", "category": "File Browser" },
      { "command": "dilopsFileBrowser.download", "title": "Download to My Computer…", "category": "File Browser", "icon": "$(cloud-download)" },
      { "command": "dilopsFileBrowser.openFolder", "title": "Open Folder", "category": "File Browser" },
      { "command": "dilopsFileBrowser.openFolderInNewWindow", "title": "Open Folder in New Window", "category": "File Browser" },
      { "command": "dilopsFileBrowser.addToWorkspace", "title": "Add Folder to Workspace", "category": "File Browser" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "dilopsFileBrowser.removeBookmark", "when": "false" },
        { "command": "dilopsFileBrowser.renameBookmark", "when": "false" },
        { "command": "dilopsFileBrowser.moveBookmarkToGroup", "when": "false" },
        { "command": "dilopsFileBrowser.renameGroup", "when": "false" },
        { "command": "dilopsFileBrowser.deleteGroup", "when": "false" },
        { "command": "dilopsFileBrowser.revealInOS", "when": "false" },
        { "command": "dilopsFileBrowser.copyPath", "when": "false" },
        { "command": "dilopsFileBrowser.openInTerminal", "when": "false" },
        { "command": "dilopsFileBrowser.addChildAsBookmark", "when": "false" },
        { "command": "dilopsFileBrowser.openFile", "when": "false" },
        { "command": "dilopsFileBrowser.newFile", "when": "false" },
        { "command": "dilopsFileBrowser.newFolder", "when": "false" },
        { "command": "dilopsFileBrowser.rename", "when": "false" },
        { "command": "dilopsFileBrowser.delete", "when": "false" },
        { "command": "dilopsFileBrowser.duplicate", "when": "false" },
        { "command": "dilopsFileBrowser.copy", "when": "false" },
        { "command": "dilopsFileBrowser.cut", "when": "false" },
        { "command": "dilopsFileBrowser.paste", "when": "false" },
        { "command": "dilopsFileBrowser.compare", "when": "false" },
        { "command": "dilopsFileBrowser.runFile", "when": "false" },
        { "command": "dilopsFileBrowser.showBookmarkDiskUsage", "when": "false" },
        { "command": "dilopsFileBrowser.download", "when": "false" },
        { "command": "dilopsFileBrowser.openFolder", "when": "false" },
        { "command": "dilopsFileBrowser.openFolderInNewWindow", "when": "false" },
        { "command": "dilopsFileBrowser.addToWorkspace", "when": "false" }
      ],
      "view/title": [
        { "command": "dilopsFileBrowser.addBookmark", "when": "view == dilopsFileBrowser.tree", "group": "navigation@1" },
        { "command": "dilopsFileBrowser.newGroup", "when": "view == dilopsFileBrowser.tree", "group": "navigation@2" },
        { "command": "dilopsFileBrowser.goToPath", "when": "view == dilopsFileBrowser.tree", "group": "navigation@3" },
        { "command": "dilopsFileBrowser.revealActiveEditor", "when": "view == dilopsFileBrowser.tree", "group": "navigation@1a" },
        { "command": "dilopsFileBrowser.setTypeFilter", "when": "view == dilopsFileBrowser.tree", "group": "navigation@3a" },
        { "command": "dilopsFileBrowser.sortBy", "when": "view == dilopsFileBrowser.tree", "group": "navigation@4" },
        { "command": "dilopsFileBrowser.enableShowModified", "when": "view == dilopsFileBrowser.tree && !dilopsFileBrowser.showModified", "group": "navigation@5" },
        { "command": "dilopsFileBrowser.disableShowModified", "when": "view == dilopsFileBrowser.tree && dilopsFileBrowser.showModified", "group": "navigation@5" },
        { "command": "dilopsFileBrowser.enableShowSize", "when": "view == dilopsFileBrowser.tree && !dilopsFileBrowser.showSize", "group": "navigation@6" },
        { "command": "dilopsFileBrowser.disableShowSize", "when": "view == dilopsFileBrowser.tree && dilopsFileBrowser.showSize", "group": "navigation@6" },
        { "command": "dilopsFileBrowser.enableShowHiddenFiles", "when": "view == dilopsFileBrowser.tree && !dilopsFileBrowser.showHiddenFiles", "group": "navigation@7" },
        { "command": "dilopsFileBrowser.disableShowHiddenFiles", "when": "view == dilopsFileBrowser.tree && dilopsFileBrowser.showHiddenFiles", "group": "navigation@7" },
        { "command": "dilopsFileBrowser.refresh", "when": "view == dilopsFileBrowser.tree", "group": "navigation@8" }
      ],
      "view/item/context": [
        { "command": "dilopsFileBrowser.searchInBookmark", "when": "view == dilopsFileBrowser.tree && viewItem == bookmark", "group": "0_search@1" },
        { "command": "dilopsFileBrowser.searchInBookmark", "when": "view == dilopsFileBrowser.tree && viewItem == folder", "group": "0_search@1" },
        { "command": "dilopsFileBrowser.runFile", "when": "view == dilopsFileBrowser.tree && viewItem == file", "group": "0_search@2" },
        { "command": "dilopsFileBrowser.runFile", "when": "view == dilopsFileBrowser.tree && viewItem == recentFile", "group": "0_search@2" },
        { "command": "dilopsFileBrowser.compare", "when": "view == dilopsFileBrowser.tree && (viewItem == file || viewItem == recentFile)", "group": "0_search@3" },
        { "command": "dilopsFileBrowser.download", "when": "view == dilopsFileBrowser.tree && (viewItem == file || viewItem == folder || viewItem == recentFile)", "group": "0_search@4" },
        { "command": "dilopsFileBrowser.copy", "when": "view == dilopsFileBrowser.tree && (viewItem == file || viewItem == folder)", "group": "1a_clip@1" },
        { "command": "dilopsFileBrowser.cut", "when": "view == dilopsFileBrowser.tree && (viewItem == file || viewItem == folder)", "group": "1a_clip@2" },
        { "command": "dilopsFileBrowser.paste", "when": "view == dilopsFileBrowser.tree && (viewItem == bookmark || viewItem == folder) && dilopsFileBrowser.hasClipboard", "group": "1a_clip@3" },
        { "command": "dilopsFileBrowser.showBookmarkDiskUsage", "when": "view == dilopsFileBrowser.tree && viewItem == bookmark", "group": "3_open@3" },
        { "command": "dilopsFileBrowser.newFile", "when": "view == dilopsFileBrowser.tree && (viewItem == bookmark || viewItem == folder)", "group": "1_create@1" },
        { "command": "dilopsFileBrowser.newFolder", "when": "view == dilopsFileBrowser.tree && (viewItem == bookmark || viewItem == folder)", "group": "1_create@2" },
        { "command": "dilopsFileBrowser.addChildAsBookmark", "when": "view == dilopsFileBrowser.tree && viewItem == folder", "group": "1_create@3" },
        { "command": "dilopsFileBrowser.rename", "when": "view == dilopsFileBrowser.tree && (viewItem == folder || viewItem == file)", "group": "2_modify@1" },
        { "command": "dilopsFileBrowser.duplicate", "when": "view == dilopsFileBrowser.tree && (viewItem == folder || viewItem == file)", "group": "2_modify@2" },
        { "command": "dilopsFileBrowser.delete", "when": "view == dilopsFileBrowser.tree && (viewItem == folder || viewItem == file)", "group": "2_modify@3" },
        { "command": "dilopsFileBrowser.renameBookmark", "when": "view == dilopsFileBrowser.tree && viewItem == bookmark", "group": "2_modify@1" },
        { "command": "dilopsFileBrowser.moveBookmarkToGroup", "when": "view == dilopsFileBrowser.tree && viewItem == bookmark", "group": "2_modify@2" },
        { "command": "dilopsFileBrowser.removeBookmark", "when": "view == dilopsFileBrowser.tree && viewItem == bookmark", "group": "2_modify@3" },
        { "command": "dilopsFileBrowser.renameGroup", "when": "view == dilopsFileBrowser.tree && viewItem == group", "group": "2_modify@1" },
        { "command": "dilopsFileBrowser.deleteGroup", "when": "view == dilopsFileBrowser.tree && viewItem == group", "group": "2_modify@2" },
        { "command": "dilopsFileBrowser.openFolder", "when": "view == dilopsFileBrowser.tree && (viewItem == bookmark || viewItem == folder)", "group": "2b_workspace@1" },
        { "command": "dilopsFileBrowser.openFolderInNewWindow", "when": "view == dilopsFileBrowser.tree && (viewItem == bookmark || viewItem == folder)", "group": "2b_workspace@2" },
        { "command": "dilopsFileBrowser.addToWorkspace", "when": "view == dilopsFileBrowser.tree && (viewItem == bookmark || viewItem == folder)", "group": "2b_workspace@3" },
        { "command": "dilopsFileBrowser.openInTerminal", "when": "view == dilopsFileBrowser.tree && viewItem =~ /^(bookmark|folder|file|recentFile)$/", "group": "3_open@1" },
        { "command": "dilopsFileBrowser.revealInOS", "when": "view == dilopsFileBrowser.tree && viewItem =~ /^(bookmark|folder|file|recentFile)$/", "group": "3_open@2" },
        { "command": "dilopsFileBrowser.copyPath", "when": "view == dilopsFileBrowser.tree && viewItem =~ /^(bookmark|folder|file|recentFile)$/", "group": "4_copy@1" },
        { "command": "dilopsFileBrowser.clearRecent", "when": "view == dilopsFileBrowser.tree && viewItem == recentSection", "group": "1_modify@1" }
      ]
    },
    "configuration": {
      "title": "File Browser",
      "properties": {
        "dilopsFileBrowser.showHiddenFiles": {
          "type": "boolean",
          "default": false,
          "description": "Show files and folders that start with a dot."
        },
        "dilopsFileBrowser.foldersFirst": {
          "type": "boolean",
          "default": true,
          "description": "Sort folders before files within each directory."
        },
        "dilopsFileBrowser.respectFilesExclude": {
          "type": "boolean",
          "default": true,
          "description": "Honor the workspace `files.exclude` glob patterns (e.g. hide node_modules, .git). Patterns are matched against paths relative to each bookmark root."
        },
        "dilopsFileBrowser.sortBy": {
          "type": "string",
          "enum": ["name", "modified", "size"],
          "default": "name",
          "description": "Sort files and folders by this attribute."
        },
        "dilopsFileBrowser.sortDirection": {
          "type": "string",
          "enum": ["asc", "desc"],
          "default": "asc",
          "description": "Sort direction. `asc`: A→Z / oldest→newest / smallest→largest. `desc`: reverse."
        },
        "dilopsFileBrowser.showModified": {
          "type": "boolean",
          "default": true,
          "description": "Show relative modification time next to each file and folder."
        },
        "dilopsFileBrowser.watchPollingIntervalMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "description": "How often (ms) to poll expanded directories for external changes. Needed because inotify (fs.watch) is unreliable over NFS. Lower = snappier, higher = fewer NFS round-trips."
        },
        "dilopsFileBrowser.showBookmarkDiskUsage": {
          "type": "boolean",
          "default": false,
          "description": "Show total disk usage next to each bookmark. Computed asynchronously via `du -sb` and cached for 5 minutes."
        },
        "dilopsFileBrowser.runners": {
          "type": "object",
          "default": {
            ".R": "Rscript ${file}",
            ".Rmd": "R -e \"rmarkdown::render('${file}')\"",
            ".py": "python ${file}",
            ".sh": "bash ${file}",
            ".bash": "bash ${file}",
            ".qmd": "quarto render ${file}"
          },
          "description": "Command templates for the Run File command, keyed by file extension. `${file}` is replaced with the (shell-quoted) file path. Commands run in a new terminal cd'd to the file's directory."
        },
        "dilopsFileBrowser.modifiedFormat": {
          "type": "string",
          "enum": ["compact", "relative"],
          "enumDescriptions": [
            "Terse: 2h, 3d, Jul 1",
            "Verbose: 2h ago, 3d ago, Jul 1"
          ],
          "default": "compact",
          "description": "Format for modification times shown in the tree."
        },
        "dilopsFileBrowser.showSize": {
          "type": "boolean",
          "default": false,
          "description": "Show file size (e.g. `4.2 KB`) next to each file."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out dilops-file-browser.vsix"
  },
  "dependencies": {
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
